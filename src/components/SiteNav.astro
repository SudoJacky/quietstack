---
import BrandLogo from '@/components/BrandLogo.astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import { routes, site } from '@/lib/site';

const repoUrl = 'https://github.com/SudoJacky/quietstack';
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={routes.home} aria-label={`${site.name} home`}>
      <BrandLogo />
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={routes.posts}>Posts</a>
      <a href={routes.notes}>Notes</a>
      <a href={routes.archive}>Archive</a>
      <a href={routes.search}>Search</a>
      <a href={`${routes.home}about/`}>About</a>
      <button class="site-nav__command" type="button" data-command-open aria-label="Open command palette">
        <span>⌘K</span>
      </button>
      <a class="site-nav__github" href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label="View Quietstack on GitHub">
        <GitHubIcon />
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>
