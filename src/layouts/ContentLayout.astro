---
import BaseLayout from './BaseLayout.astro';
import { formatDate, tagUrl } from '@/lib/content';
import { filterTocHeadings } from '@/lib/toc.js';
import SourceViewer from '@/components/SourceViewer.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  title: string;
  description?: string;
  canonicalUrl?: string;
  cover?: {
    image: string;
    alt: string;
  };
  date?: Date;
  updatedDate?: Date;
  tags?: string[];
  type: string;
  discussionLinks?: { label: string; url: string }[];
  headings?: Heading[];
  readingSlug?: string;
  readingNavigation?: {
    previous?: ReadingLink;
    next?: ReadingLink;
    related?: ReadingLink[];
  };
  sourceReferences?: {
    id: string;
    title: string;
    path: string;
    body: string;
    pdf?: string;
  }[];
};

type ReadingLink = {
  href: string;
  title: string;
  description?: string;
  date?: string;
  tags?: string[];
};

const {
  title,
  description,
  canonicalUrl,
  cover,
  date,
  updatedDate,
  tags = [],
  type,
  discussionLinks = [],
  headings = [],
  readingSlug,
  readingNavigation,
  sourceReferences = [],
} = Astro.props;
const tocHeadings = filterTocHeadings(headings) as Heading[];
const hasReadingNavigation = Boolean(readingNavigation?.previous || readingNavigation?.next || readingNavigation?.related?.length);
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  image={cover ? { url: cover.image, alt: cover.alt } : undefined}
  ogType={type.includes('Post') || type.includes('Note') ? 'article' : 'website'}
  publishedTime={date}
  modifiedTime={updatedDate}
  tags={tags}
>
  <div class="reading-progress" aria-hidden="true">
    <span data-reading-progress></span>
  </div>
  <article class:list={['article shell', tocHeadings.length ? 'article--with-toc' : '']} data-article-reading-slug={readingSlug}>
    {tocHeadings.length ? (
      <aside class="article-toc" aria-label="Table of contents">
        <p class="article-toc__title">Contents</p>
        <span class="article-toc__indicator" data-toc-indicator hidden></span>
        <nav>
          <ol>
            {tocHeadings.map((heading) => (
              <li class={`article-toc__item article-toc__item--depth-${heading.depth}`}>
                <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    ) : null}
    <div class="article__main">
      <header class="article__header">
        <p class="eyebrow">{type}{date ? ` / ${formatDate(date)}` : ''}</p>
        <h1>{title}</h1>
        {description ? <p class="muted">{description}</p> : null}
        {tags.length ? (
          <ul class="pill-list" aria-label="Tags">
            {tags.map((tag) => <li><a class="pill" href={tagUrl(tag)}>{tag}</a></li>)}
          </ul>
        ) : null}
      </header>
      <div class="article__body" data-pagefind-body>
        <slot />
      </div>
      <SourceViewer sources={sourceReferences} />
      {hasReadingNavigation ? (
        <nav class="reading-navigation" aria-label="Continue reading">
          {(readingNavigation?.previous || readingNavigation?.next) ? (
            <div class="reading-navigation__adjacent">
              {readingNavigation?.previous ? (
                <a class="reading-navigation__link" href={readingNavigation.previous.href}>
                  <span>Previous</span>
                  <strong>{readingNavigation.previous.title}</strong>
                </a>
              ) : <span></span>}
              {readingNavigation?.next ? (
                <a class="reading-navigation__link reading-navigation__link--next" href={readingNavigation.next.href}>
                  <span>Next</span>
                  <strong>{readingNavigation.next.title}</strong>
                </a>
              ) : <span></span>}
            </div>
          ) : null}
          {readingNavigation?.related?.length ? (
            <div class="reading-navigation__related">
              <p class="eyebrow">Related</p>
              <div class="reading-navigation__grid">
                {readingNavigation.related.map((item) => (
                  <a class="reading-navigation__card" href={item.href}>
                    <span>{item.tags?.slice(0, 2).join(' / ')}</span>
                    <strong>{item.title}</strong>
                    {item.description ? <p>{item.description}</p> : null}
                  </a>
                ))}
              </div>
            </div>
          ) : null}
        </nav>
      ) : null}
      {discussionLinks.length ? (
        <footer class="article__footer">
          <p class="eyebrow">Discuss</p>
          <ul class="pill-list">
            {discussionLinks.map((link) => <li><a class="pill" href={link.url}>{link.label}</a></li>)}
          </ul>
        </footer>
      ) : null}
    </div>
  </article>
</BaseLayout>

<script>
  import { readingProgressRatio, tocIndicatorStyle } from '@/lib/article-motion.js';
  import { readReadingState, updateReadingEntry, writeReadingState } from '@/lib/reading-state.js';
  import { getActiveTocSlug } from '@/lib/toc.js';
  import { initSourceViewer } from '@/lib/source-viewer.js';

  const progress = document.querySelector('[data-reading-progress]');
  const article = document.querySelector('[data-article-reading-slug]');
  const readingSlug = article?.getAttribute('data-article-reading-slug') ?? '';
  const tocIndicator = document.querySelector('[data-toc-indicator]');
  const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
  const tocEntries = tocLinks.flatMap((link) => {
    const slug = link.getAttribute('href')?.replace(/^#/, '');
    if (!slug) return [];

    let id = slug;
    try {
      id = decodeURIComponent(slug);
    } catch {
      id = slug;
    }

    const heading = document.getElementById(id);
    return heading ? [{ link, heading, slug: id }] : [];
  });

  let pendingFrame = 0;
  let lastStoredReadingRatio = -1;

  function updateStoredReadingState(ratio: number) {
    if (!readingSlug) return;
    if (Math.abs(ratio - lastStoredReadingRatio) < 0.04 && ratio < 0.85) return;

    const state = readReadingState();
    writeReadingState(updateReadingEntry(state, readingSlug, ratio));
    lastStoredReadingRatio = ratio;
  }

  function updateReadingProgress() {
    if (!(progress instanceof HTMLElement)) return;

    const ratio = readingProgressRatio({
      scrollY: window.scrollY,
      viewportHeight: window.innerHeight,
      documentHeight: document.documentElement.scrollHeight,
    });
    progress.style.transform = `scaleX(${ratio})`;
    updateStoredReadingState(ratio);
  }

  function updateActiveTocLink() {
    pendingFrame = 0;
    const headings = tocEntries.map((entry) => ({
      slug: entry.slug,
      top: entry.heading.getBoundingClientRect().top + window.scrollY,
    }));
    const activeSlug = getActiveTocSlug(headings, window.scrollY, 96);

    for (const entry of tocEntries) {
      entry.link.classList.toggle('is-active', entry.slug === activeSlug);
    }

    const activeEntry = tocEntries.find((entry) => entry.slug === activeSlug);
    if (tocIndicator instanceof HTMLElement && activeEntry?.link instanceof HTMLElement) {
      const style = tocIndicatorStyle({
        linkTop: activeEntry.link.offsetTop,
        containerTop: 0,
        linkHeight: activeEntry.link.offsetHeight,
      });
      tocIndicator.style.setProperty('--toc-indicator-top', style.top);
      tocIndicator.style.setProperty('--toc-indicator-height', style.height);
      tocIndicator.hidden = false;
    }
  }

  function updateArticleMotion() {
    updateReadingProgress();
    if (tocEntries.length) updateActiveTocLink();
    pendingFrame = 0;
  }

  function scheduleArticleMotionUpdate() {
    if (pendingFrame) return;
    pendingFrame = window.requestAnimationFrame(updateArticleMotion);
  }

  updateReadingProgress();

  if (tocEntries.length) {
    updateActiveTocLink();
  }

  window.addEventListener('scroll', scheduleArticleMotionUpdate, { passive: true });
  window.addEventListener('resize', scheduleArticleMotionUpdate);
  window.addEventListener('hashchange', scheduleArticleMotionUpdate);

  initSourceViewer();
</script>
