---
import SiteNav from '@/components/SiteNav.astro';
import { routes, site } from '@/lib/site';
import { absoluteUrl, assetUrl } from '@/lib/url';
import '@/styles/global.css';
import '@/themes/default/theme.css';

type Props = {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  image?: {
    url: string;
    alt: string;
  };
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
};

const pageTitle = Astro.props.title ? `${Astro.props.title} - ${site.name}` : site.name;
const description = Astro.props.description ?? site.description;
const canonicalUrl = Astro.props.canonicalUrl ?? absoluteUrl('/');
const image = Astro.props.image ?? {
  url: site.defaultSocialImage,
  alt: `${site.name} social preview`,
};
const imageUrl = assetUrl(image.url);
const ogType = Astro.props.ogType ?? 'website';
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Posts`} href={routes.mainFeed} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Notes`} href={routes.notesFeed} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    {Astro.props.publishedTime ? <meta property="article:published_time" content={Astro.props.publishedTime.toISOString()} /> : null}
    {Astro.props.modifiedTime ? <meta property="article:modified_time" content={Astro.props.modifiedTime.toISOString()} /> : null}
    {Astro.props.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </head>
  <body>
    <SiteNav />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div>
          <a class="site-footer__brand" href={routes.home}>{site.name}</a>
          <p>{site.description}</p>
        </div>
        <nav class="site-footer__nav" aria-label="Footer navigation">
          <a href={routes.posts}>Posts</a>
          <a href={routes.notes}>Notes</a>
          <a href={routes.archive}>Archive</a>
          <a href={routes.search}>Search</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
