---
import { getVisibleNotes, getVisiblePosts, noteTitle, noteUrl, postUrl } from '@/lib/content';
import { routes } from '@/lib/site';

const posts = await getVisiblePosts();
const notes = await getVisibleNotes();
const entries = [
  { title: 'Posts', type: 'Navigation', url: routes.posts, tags: ['writing'] },
  { title: 'Notes', type: 'Navigation', url: routes.notes, tags: ['notes'] },
  { title: 'Archive', type: 'Navigation', url: routes.archive, tags: ['timeline'] },
  { title: 'Search', type: 'Navigation', url: routes.search, tags: ['find'] },
  { title: 'About', type: 'Navigation', url: `${routes.home}about/`, tags: ['site'] },
  ...posts.slice(0, 8).map((post) => ({
    title: post.data.title,
    type: 'Post',
    url: postUrl(post),
    tags: post.data.tags,
  })),
  ...notes.slice(0, 8).map((note) => ({
    title: noteTitle(note),
    type: 'Note',
    url: noteUrl(note),
    tags: note.data.tags,
  })),
];
---

<div class="command-palette" data-command-palette hidden>
  <div class="command-palette__backdrop" data-command-close></div>
  <section class="command-palette__dialog" role="dialog" aria-modal="true" aria-labelledby="command-palette-title">
    <div class="command-palette__header">
      <p class="eyebrow" id="command-palette-title">Jump to</p>
      <button type="button" data-command-close aria-label="Close command palette">Esc</button>
    </div>
    <label class="command-palette__search">
      <span class="sr-only">Filter commands</span>
      <input data-command-input type="search" placeholder="Search pages, posts, and notes" autocomplete="off" />
    </label>
    <div class="command-palette__results" data-command-results></div>
  </section>
  <script is:inline type="application/json" data-command-entries set:html={JSON.stringify(entries)}></script>
</div>

<script>
  import { filterCommandEntries, nextCommandIndex } from '@/lib/command-palette.js';

  type CommandEntry = {
    title: string;
    type: string;
    url: string;
    tags: string[];
  };

  const palette = document.querySelector('[data-command-palette]');
  const input = document.querySelector('[data-command-input]');
  const results = document.querySelector('[data-command-results]');
  const entriesData = document.querySelector('[data-command-entries]');
  const openButtons = Array.from(document.querySelectorAll('[data-command-open]'));
  const closeButtons = Array.from(document.querySelectorAll('[data-command-close]'));
  const entries = (entriesData?.textContent ? JSON.parse(entriesData.textContent) : []) as CommandEntry[];
  let visibleEntries: CommandEntry[] = [];
  let activeIndex = -1;
  let previousFocus: Element | null = null;

  function escapeHtml(value: unknown) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function renderResults() {
    if (!(results instanceof HTMLElement)) return;
    visibleEntries = filterCommandEntries(entries, input instanceof HTMLInputElement ? input.value : '', 12);
    if (activeIndex >= visibleEntries.length) activeIndex = visibleEntries.length - 1;
    if (activeIndex < 0 && visibleEntries.length) activeIndex = 0;

    results.innerHTML = visibleEntries.length
      ? visibleEntries.map((entry, index) => `
        <a class="command-palette__item ${index === activeIndex ? 'is-active' : ''}" href="${escapeHtml(entry.url)}" data-command-index="${index}">
          <span>${escapeHtml(entry.type)}</span>
          <strong>${escapeHtml(entry.title)}</strong>
        </a>
      `).join('')
      : '<p class="empty-state">No matches.</p>';
  }

  function openPalette() {
    if (!(palette instanceof HTMLElement)) return;
    previousFocus = document.activeElement;
    palette.hidden = false;
    activeIndex = 0;
    if (input instanceof HTMLInputElement) {
      input.value = '';
      input.focus();
    }
    renderResults();
  }

  function closePalette() {
    if (!(palette instanceof HTMLElement)) return;
    palette.hidden = true;
    if (previousFocus instanceof HTMLElement) previousFocus.focus();
  }

  for (const button of openButtons) {
    button.addEventListener('click', openPalette);
  }

  for (const button of closeButtons) {
    button.addEventListener('click', closePalette);
  }

  input?.addEventListener('input', () => {
    activeIndex = 0;
    renderResults();
  });

  results?.addEventListener('mousemove', (event) => {
    const item = event.target instanceof Element ? event.target.closest('[data-command-index]') : null;
    if (!item) return;
    activeIndex = Number(item.getAttribute('data-command-index'));
    renderResults();
  });

  document.addEventListener('keydown', (event) => {
    const isPaletteShortcut = (event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === 'k';
    if (isPaletteShortcut) {
      event.preventDefault();
      openPalette();
      return;
    }

    if (!(palette instanceof HTMLElement) || palette.hidden) return;

    if (event.key === 'Escape') {
      closePalette();
      return;
    }

    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      activeIndex = nextCommandIndex(activeIndex, event.key === 'ArrowDown' ? 1 : -1, visibleEntries.length);
      renderResults();
      return;
    }

    if (event.key === 'Enter' && visibleEntries[activeIndex]) {
      event.preventDefault();
      window.location.href = visibleEntries[activeIndex].url;
    }
  });
</script>
