---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCard from '@/components/ContentCard.astro';
import { getVisibleNotes, getVisiblePosts, getVisibleSources, noteTitle, noteUrl, postUrl } from '@/lib/content';
import { buildHeroStats, publishingFlowSteps, sourceShowcase } from '@/lib/home-showcase.js';
import { paths, routes, site } from '@/lib/site';
import { absoluteUrl } from '@/lib/url';

const allPosts = await getVisiblePosts();
const allNotes = await getVisibleNotes();
const allSources = await getVisibleSources();
const posts = allPosts.slice(0, 4);
const notes = allNotes.slice(0, 2);
const heroStats = buildHeroStats({ posts: allPosts, notes: allNotes, sources: allSources });
---

<BaseLayout title="Home" description={site.description} canonicalUrl={absoluteUrl(paths.home)}>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Static personal publishing</p>
        <h1>{site.name}</h1>
        <p>
          {site.description} Publish Markdown, cite source attachments, rebuild Pagefind search, and ship a portable static site
          from one repository-backed workflow.
        </p>
        <div class="hero__stats" aria-label="Quietstack content status">
          {heroStats.map((stat) => (
            <span class={`hero-stat hero-stat--${stat.tone}`}>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </span>
          ))}
        </div>
        <div class="hero__actions">
          <a class="button button--primary" href={routes.posts}>Start reading</a>
          <a class="button button--secondary" href={routes.archive}>Browse archive</a>
        </div>
      </div>
      <div class="publishing-cockpit" aria-label="Quietstack publishing preview">
        <div class="cockpit-toolbar">
          <div class="cockpit-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <span>publish preview</span>
          <strong>ready</strong>
        </div>

        <div class="cockpit-preview">
          <p class="eyebrow">Article</p>
          <h2>{sourceShowcase.articleTitle}</h2>
          <p>
            Long-lived writing stays readable while source-backed claims open the exact attachment context beside the article.
          </p>
          <span class="citation-chip">{sourceShowcase.citation}</span>
        </div>

        <div class="source-mini" aria-label="Source attachment excerpt">
          <div>
            <span>Source</span>
            <strong>{sourceShowcase.sourceTitle}</strong>
            <small>{sourceShowcase.sourcePath}</small>
          </div>
          <ol>
            {sourceShowcase.lines.map((line) => (
              <li class={line.highlighted ? 'is-highlighted' : undefined}>
                <span>{line.number}</span>
                <code>{line.text || ' '}</code>
              </li>
            ))}
          </ol>
        </div>

        <div class="build-command">
          <span>$</span>
          <code>{sourceShowcase.command}</code>
        </div>
      </div>
    </div>
  </section>

  <section class="section pipeline-section" aria-labelledby="pipeline-title">
    <div class="shell">
      <div class="section__header">
        <p class="eyebrow">Publishing system</p>
        <h2 id="pipeline-title">From note to indexed static artifact.</h2>
      </div>
      <ol class="pipeline-strip">
        {publishingFlowSteps.map((step) => (
          <li>
            <span>{step.label}</span>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="shell">
      <div class="section__header">
        <p class="eyebrow">Latest Posts</p>
        <h2>Long-form writing</h2>
      </div>
      <div class="content-grid">
        {posts.map((post) => (
          <ContentCard
            href={postUrl(post)}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            type="Post"
          />
        ))}
      </div>
      <p class="section__link"><a href={routes.posts}>View all posts</a></p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section__header">
        <p class="eyebrow">Latest Notes</p>
        <h2>Short-form notes</h2>
      </div>
      <div class="content-grid">
        {notes.map((note) => (
          <ContentCard
            href={noteUrl(note)}
            title={noteTitle(note, 44)}
            date={note.data.pubDate}
            type="Note"
          />
        ))}
      </div>
      <p class="section__link"><a href={routes.notes}>View all notes</a></p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="cta-band">
        <div>
          <p class="eyebrow">Static by default</p>
          <h2>Keep publishing portable, readable, and calm.</h2>
        </div>
        <a class="button button--inverted" href={routes.search}>Search content</a>
      </div>
    </div>
  </section>
</BaseLayout>
