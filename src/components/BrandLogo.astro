---
import { site } from '@/lib/site';

type Props = {
  label?: string;
};

const { label = site.name } = Astro.props;
---

<span class="brand-lockup">
  <span class="brand-mark" aria-hidden="true">
    <span class="brand-mark__ring"></span>
    <span class="brand-mark__stack"></span>
  </span>
  <span>{label}</span>
</span>
