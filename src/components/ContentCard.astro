---
import { formatDate } from '@/lib/content';

type Props = {
  href: string;
  title: string;
  description?: string;
  date?: Date;
  type?: string;
  tags?: string[];
};

const { href, title, description, date, type, tags = [] } = Astro.props;
const normalizedType = type?.toLocaleLowerCase() ?? '';
const normalizedTags = tags.map((tag) => tag.normalize('NFKC').trim().toLocaleLowerCase()).join('|');
---

<a class="card" href={href} data-archive-card data-content-type={normalizedType} data-content-tags={normalizedTags}>
  <div class="card__meta">
    {type ? <span>{type}</span> : null}
    {date ? <span>{type ? ' / ' : ''}{formatDate(date)}</span> : null}
  </div>
  <h2>{title}</h2>
  {description ? <p>{description}</p> : null}
  {tags.length ? (
    <ul class="card__tags" aria-label="Tags">
      {tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
    </ul>
  ) : null}
</a>
