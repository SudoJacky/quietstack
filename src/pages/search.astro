---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { paths } from '@/lib/site';
import { absoluteUrl, withBase } from '@/lib/url';

const pagefindModuleUrl = withBase('/pagefind/pagefind.js');
const pagefindBundlePath = withBase('/pagefind/');
const staticSearchIndexUrl = withBase('/search-index.json');
const preferStaticSearch = import.meta.env.DEV;
---

<BaseLayout title="Search" description="Search Posts and Notes." canonicalUrl={absoluteUrl(paths.search)}>
  <header class="shell listing-header">
    <p class="eyebrow">Full Text Search</p>
    <h1>Search</h1>
  </header>
  <section class="shell section">
    <input class="search-box" id="search-input" type="search" placeholder="Search posts, notes, and pages" autocomplete="off" />
    <div id="search-results" class="content-grid" style="margin-top: 1rem;"></div>
  </section>
  <span
    hidden
    data-pagefind-module-url={pagefindModuleUrl}
    data-pagefind-bundle-path={pagefindBundlePath}
    data-static-search-index-url={staticSearchIndexUrl}
    data-prefer-static-search={String(preferStaticSearch)}
  ></span>
  <script>
    import { renderSearchResult, renderSearchState, searchStaticItems } from '@/lib/pagefind-search.js';

    type PagefindResultData = {
      url: string;
      meta: {
        title?: string;
      };
      excerpt: string;
    };

    type PagefindResult = {
      data: () => Promise<PagefindResultData>;
    };

    type PagefindModule = {
      options: (options: { bundlePath: string; highlightParam: string }) => Promise<void>;
      search: (query: string) => Promise<{ results: PagefindResult[] }>;
    };

    type StaticSearchItem = {
      type: string;
      title: string;
      description?: string;
      excerpt?: string;
      url: string;
      date: string;
      tags: string[];
      searchText?: string;
    };

    const input = document.querySelector('#search-input');
    const results = document.querySelector('#search-results');
    const pagefindConfig = document.querySelector('[data-pagefind-module-url]');
    const pagefindModuleUrl = pagefindConfig?.getAttribute('data-pagefind-module-url') ?? '/pagefind/pagefind.js';
    const pagefindBundlePath = pagefindConfig?.getAttribute('data-pagefind-bundle-path') ?? '/pagefind/';
    const staticSearchIndexUrl = pagefindConfig?.getAttribute('data-static-search-index-url') ?? '/search-index.json';
    const preferStaticSearch = pagefindConfig?.getAttribute('data-prefer-static-search') === 'true';
    let pagefindPromise: Promise<PagefindModule> | undefined;
    let staticSearchPromise: Promise<StaticSearchItem[]> | undefined;
    let searchSequence = 0;

    async function loadPagefind() {
      if (!pagefindPromise) {
        pagefindPromise = import(/* @vite-ignore */ pagefindModuleUrl).then(async (pagefind) => {
          await pagefind.options({ bundlePath: pagefindBundlePath, highlightParam: 'highlight' });
          return pagefind as PagefindModule;
        });
      }
      return pagefindPromise;
    }

    async function loadStaticSearchItems() {
      if (!staticSearchPromise) {
        staticSearchPromise = fetch(staticSearchIndexUrl).then((response) => {
          if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
          return response.json() as Promise<StaticSearchItem[]>;
        });
      }
      return staticSearchPromise;
    }

    async function searchWithStaticIndex(query: string) {
      const items = await loadStaticSearchItems();
      return searchStaticItems(items, query, 24);
    }

    async function render(query: string) {
      if (!results) return;
      const normalized = query.trim();
      const sequence = ++searchSequence;

      if (!normalized) {
        results.innerHTML = renderSearchState('idle');
        return;
      }

      results.innerHTML = renderSearchState('loading');

      if (preferStaticSearch) {
        try {
          const data = await searchWithStaticIndex(normalized);
          if (sequence !== searchSequence) return;
          results.innerHTML = data.length ? data.map(renderSearchResult).join('') : renderSearchState('empty');
        } catch (fallbackError) {
          if (sequence !== searchSequence) return;
          console.error(fallbackError);
          results.innerHTML = renderSearchState('unavailable');
        }
        return;
      }

      try {
        const pagefind = await loadPagefind();
        const search = await pagefind.search(normalized);
        const data = await Promise.all(search.results.slice(0, 24).map((result) => result.data()));

        if (sequence !== searchSequence) return;

        results.innerHTML = data.length
          ? data
            .map((item) =>
              renderSearchResult({
                url: item.url,
                title: item.meta.title ?? item.url,
                excerpt: item.excerpt,
              }),
            )
            .join('')
          : renderSearchState('empty');
      } catch (error) {
        if (sequence !== searchSequence) return;
        console.warn('Pagefind search unavailable, falling back to the static search index.', error);

        try {
          const data = await searchWithStaticIndex(normalized);
          if (sequence !== searchSequence) return;
          results.innerHTML = data.length ? data.map(renderSearchResult).join('') : renderSearchState('empty');
        } catch (fallbackError) {
          if (sequence !== searchSequence) return;
          console.error(fallbackError);
          results.innerHTML = renderSearchState('unavailable');
        }
      }
    }

    if (input instanceof HTMLInputElement) {
      input.addEventListener('input', () => {
        window.clearTimeout(Number(input.dataset.searchTimer ?? 0));
        input.dataset.searchTimer = String(window.setTimeout(() => render(input.value), 120));
      });
    }

    render('');
  </script>
</BaseLayout>
